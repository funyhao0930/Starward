<sf:PageBase x:Class="Starward.Features.GameSetting.GameSettingPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:kuro="using:Starward.Core.Games.Kuro"
             xmlns:lang="using:Starward.Language"
             xmlns:local="using:Starward.Features.GameSetting"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:sf="using:Starward.Frameworks"
             x:DefaultBindMode="OneWay"
             mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="60" />
        </Grid.RowDefinitions>

        <ScrollViewer>
            <Grid Margin="24,20,24,24" ColumnSpacing="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Button Width="0"
                        Height="0"
                        IsHitTestVisible="False" />

                <StackPanel Margin="0,0,12,0" Visibility="{x:Bind IsBaseSettingEnable}">
                    <!--  分辨率  -->
                    <TextBlock FontSize="20"
                               FontWeight="Bold"
                               Text="{x:Bind lang:Lang.GameSettingPage_Resolution}" />
                    <!--  全屏  -->
                    <CheckBox Margin="0,8,0,0"
                              Content="{x:Bind lang:Lang.GameSettingPage_FullScreen}"
                              IsChecked="{x:Bind EnableFullScreen, Mode=TwoWay}" />
                    <!--  无边框窗口  -->
                    <CheckBox Margin="0,8,0,0"
                              Content="{x:Bind lang:Lang.GameSettingPage_UsePopupWindow}"
                              IsChecked="{x:Bind UsePopupWindow, Mode=TwoWay}" />
                    <!--  自定义分辨率  -->
                    <CheckBox Margin="0,8,0,0"
                              Content="{x:Bind lang:Lang.GameSettingPage_CustomResolution}"
                              IsChecked="{x:Bind EnableCustomResolution, Mode=TwoWay}" />
                    <ComboBox Name="ComboBox_Resolution"
                              Width="160"
                              Margin="0,8,0,0"
                              IsEnabled="{x:Bind EnableCustomResolution, Converter={StaticResource BoolReversedConverter}}"
                              SelectionChanged="ComboBox_Resolution_SelectionChanged" />
                    <StackPanel Margin="0,12,0,0"
                                Orientation="Horizontal"
                                Spacing="12">
                        <NumberBox Width="120"
                                   IsEnabled="{x:Bind EnableCustomResolution}"
                                   Minimum="0"
                                   Value="{x:Bind ResolutionWidth, Mode=TwoWay}" />
                        <TextBlock VerticalAlignment="Center"
                                   FontSize="20"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="×" />
                        <NumberBox Width="120"
                                   IsEnabled="{x:Bind EnableCustomResolution}"
                                   Minimum="0"
                                   Value="{x:Bind ResolutionHeight, Mode=TwoWay}" />
                    </StackPanel>

                    <!--  语音  -->
                    <TextBlock Margin="0,20,0,0"
                               FontSize="20"
                               FontWeight="Bold"
                               Text="{x:Bind lang:Lang.GameSettingPage_VoiceLanguage}"
                               Visibility="{x:Bind IsLanguageSettingEnable}" />
                    <!--  首次启动游戏前设置此值可以避免下载部分语音资源  -->
                    <TextBlock Margin="0,12,0,0"
                               Text="{x:Bind lang:Lang.GameSettingPage_VoiceLanguageDescription}"
                               TextWrapping="Wrap"
                               Visibility="{x:Bind IsLanguageSettingEnable}" />
                    <ComboBox Width="160"
                              Margin="0,8,0,0"
                              SelectedIndex="{x:Bind LanguageIndex, Mode=TwoWay}"
                              Visibility="{x:Bind IsLanguageSettingEnable}">
                        <!--  汉英日韩  -->
                        <ComboBoxItem Content="{x:Bind lang:Lang.Language_Chinese}" />
                        <ComboBoxItem Content="{x:Bind lang:Lang.Language_English}" />
                        <ComboBoxItem Content="{x:Bind lang:Lang.Language_Japanese}" />
                        <ComboBoxItem Content="{x:Bind lang:Lang.Language_Korean}" />
                    </ComboBox>
                </StackPanel>


                <StackPanel Grid.Column="1"
                            Spacing="12"
                            Visibility="{x:Bind IsGraphicsSettingEnable}">
                    <!--  图形设置  -->
                    <TextBlock FontSize="20"
                               FontWeight="Bold"
                               Text="{x:Bind lang:Lang.GameSettingPage_GraphicsSetting}" />

                    <!--  星铁帧率  -->
                    <StackPanel x:Name="StackPanel_StarRailFPS"
                                Spacing="8"
                                Visibility="Collapsed">
                        <TextBlock VerticalAlignment="Bottom"
                                   FontWeight="Bold"
                                   Text="{x:Bind lang:Lang.GameSettingPage_FPS}" />
                        <ComboBox Width="120" SelectedIndex="{x:Bind StarRailFpsIndex, Mode=TwoWay}">
                            <ComboBoxItem Content="30" />
                            <ComboBoxItem Content="60" />
                            <ComboBoxItem Content="120" />
                        </ComboBox>
                        <!--  请勿将游戏内「图像质量」修改为「自定义」以外的选项  -->
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="{x:Bind lang:Lang.GameSettingPage_StarRailFpsTip}"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <!--  原神 HDR  -->
                    <StackPanel x:Name="StackPanel_GenshinHDR"
                                Spacing="8"
                                Visibility="Collapsed">
                        <TextBlock FontWeight="Bold" Text="HDR" />
                        <CheckBox Content="{x:Bind lang:Lang.GameSettingPage_EnableHDR}" IsChecked="{x:Bind EnableGenshinHDR, Mode=TwoWay}" />
                        <Button Command="{x:Bind OpenGenshinHDRLumianceSettingWindowCommand}" Content="{x:Bind lang:Lang.GameSettingPage_HDRBrightnessSetting}" />
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="{x:Bind lang:Lang.GameSettingPage_IfYouHaveMultipleMonitorsYouNeedToSetTheHDRSupportedMonitorAsThePrimaryDisplay}"
                                   TextWrapping="Wrap" />
                        <InfoBar Title="{x:Bind lang:Lang.GameSettingPage_TheCurrentMonitorDoesNotSupportHDR}"
                                 Margin="0,0,24,0"
                                 IsClosable="False"
                                 IsOpen="True"
                                 Severity="Warning"
                                 Visibility="{x:Bind HDRNotSupported}" />
                        <InfoBar Title="{x:Bind lang:Lang.GameSettingPage_WindowsHDRIsNotTurnedOn}"
                                 Margin="0,0,24,0"
                                 IsClosable="False"
                                 IsOpen="True"
                                 Severity="Warning"
                                 Visibility="{x:Bind HDRNotEnabled}" />
                    </StackPanel>

                </StackPanel>


                <!--  鸣潮 Engine.ini 调校  -->
                <StackPanel Grid.Row="1"
                            Grid.ColumnSpan="2"
                            Margin="0,28,0,0"
                            Spacing="12"
                            Visibility="{x:Bind IsKuroTweakEnable}">
                    <TextBlock FontSize="20"
                               FontWeight="Bold"
                               Text="{x:Bind kuro:KuroEngineTweakText.Ui_Title}" />
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="{x:Bind kuro:KuroEngineTweakText.Ui_Description}"
                               TextWrapping="Wrap" />
                    <HyperlinkButton Margin="-12,-8,0,-4"
                                     Content="{x:Bind kuro:KuroEngineTweakText.Ui_SourceLink}"
                                     NavigateUri="https://alteriax.github.io/WuWa-Config-Info/" />

                    <InfoBar IsClosable="False"
                             IsOpen="True"
                             Message="{x:Bind kuro:KuroEngineTweakText.Ui_UserEngineIniFound}"
                             Severity="Warning"
                             Visibility="{x:Bind UserEngineIniExists}">
                        <InfoBar.ActionButton>
                            <Button HorizontalAlignment="Left"
                                    Command="{x:Bind DisableUserEngineIniCommand}"
                                    Content="{x:Bind kuro:KuroEngineTweakText.Ui_DisableUserEngineIni}" />
                        </InfoBar.ActionButton>
                    </InfoBar>

                    <InfoBar IsClosable="False"
                             IsOpen="True"
                             Message="{x:Bind KuroIneffectiveKeysMessage, Mode=OneWay}"
                             Severity="Informational"
                             Visibility="{x:Bind KuroIneffectiveKeysMessage, Mode=OneWay, Converter={StaticResource ObjectToVisibilityConverter}}" />

                    <!--  预设组合  -->
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition MaxWidth="640" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox HorizontalAlignment="Stretch"
                                  ItemsSource="{x:Bind KuroPresetNames}"
                                  PlaceholderText="{x:Bind kuro:KuroEngineTweakText.Ui_Preset}"
                                  SelectedIndex="{x:Bind SelectedKuroPresetIndex, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <TextBlock Text="{x:Bind}" TextWrapping="Wrap" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button Grid.Column="1"
                                VerticalAlignment="Top"
                                Command="{x:Bind LoadKuroPresetCommand}"
                                Content="{x:Bind kuro:KuroEngineTweakText.Ui_LoadPreset}" />
                    </Grid>
                    <TextBlock FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="{x:Bind kuro:KuroEngineTweakText.Ui_PresetNote}"
                               TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Command="{x:Bind ResetKuroTweaksCommand}" Content="{x:Bind kuro:KuroEngineTweakText.Ui_ResetAll}" />
                        <Button Command="{x:Bind OpenKuroConfigFolderCommand}" Content="{x:Bind kuro:KuroEngineTweakText.Ui_OpenFolder}" />
                    </StackPanel>

                    <!--  搜索  -->
                    <AutoSuggestBox MaxWidth="640"
                                    HorizontalAlignment="Left"
                                    PlaceholderText="{x:Bind kuro:KuroEngineTweakText.Ui_SearchPlaceholder}"
                                    QueryIcon="Find"
                                    TextChanged="AutoSuggestBox_KuroTweakSearch_TextChanged" />
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="{x:Bind kuro:KuroEngineTweakText.Ui_NoSearchResult}"
                               Visibility="{x:Bind KuroSearchNoResult, Mode=OneWay}" />

                    <!--  各分类  -->
                    <ItemsRepeater ItemsSource="{x:Bind KuroVisibleTweakCategories, Mode=OneWay}">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="8" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="local:KuroEngineTweakCategoryViewModel">
                                <Expander HorizontalAlignment="Stretch"
                                          HorizontalContentAlignment="Stretch"
                                          IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}">
                                    <Expander.Header>
                                        <Grid>
                                            <TextBlock FontWeight="SemiBold" Text="{x:Bind Title}" />
                                            <TextBlock HorizontalAlignment="Right"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       Text="{x:Bind Summary, Mode=OneWay}" />
                                        </Grid>
                                    </Expander.Header>
                                    <ItemsRepeater ItemsSource="{x:Bind VisibleItems, Mode=OneWay}">
                                        <ItemsRepeater.Layout>
                                            <StackLayout Spacing="16" />
                                        </ItemsRepeater.Layout>
                                        <ItemsRepeater.ItemTemplate>
                                            <DataTemplate x:DataType="local:KuroEngineTweakItemViewModel">
                                                <Grid ColumnSpacing="16">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Spacing="2">
                                                        <TextBlock FontWeight="{x:Bind TitleWeight, Mode=OneWay}" Text="{x:Bind Title}" />
                                                        <TextBlock FontFamily="Consolas"
                                                                   FontSize="12"
                                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                                   IsTextSelectionEnabled="True"
                                                                   Text="{x:Bind Key}" />
                                                        <TextBlock FontSize="12"
                                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                   Text="{x:Bind Description}"
                                                                   TextWrapping="Wrap" />
                                                    </StackPanel>
                                                    <ComboBox Grid.Column="1"
                                                              Width="240"
                                                              VerticalAlignment="Center"
                                                              ItemsSource="{x:Bind Options}"
                                                              SelectedItem="{x:Bind SelectedOption, Mode=TwoWay}"
                                                              Visibility="{x:Bind ChoiceVisibility}" />
                                                    <NumberBox Grid.Column="1"
                                                               Width="240"
                                                               VerticalAlignment="Center"
                                                               LargeChange="{x:Bind Step}"
                                                               PlaceholderText="{x:Bind kuro:KuroEngineTweakText.Ui_GameDefaultPlaceholder}"
                                                               SmallChange="{x:Bind Step}"
                                                               SpinButtonPlacementMode="Compact"
                                                               Value="{x:Bind NumberValue, Mode=TwoWay}"
                                                               Visibility="{x:Bind NumberVisibility}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsRepeater.ItemTemplate>
                                    </ItemsRepeater>
                                </Expander>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>


            </Grid>
        </ScrollViewer>

        <!--  游戏未安装  -->
        <StackPanel Name="StackPanel_Emoji"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="16"
                    Visibility="Collapsed">
            <Image Name="Image_Emoji"
                   Width="160"
                   Height="160" />
            <TextBlock Name="TextBlock_GameNotInstalled"
                       HorizontalAlignment="Center"
                       FontSize="16"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="{x:Bind lang:Lang.GameSettingPage_GameNotInstalled}" />
        </StackPanel>


        <Grid Name="Grid_ApplyBackground"
              Grid.Row="1"
              Background="{ThemeResource CustomOverlayAcrylicBrush}"
              CornerRadius="8,0,0,0">

            <StackPanel Margin="24,0,24,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                <Button Height="36"
                        BorderThickness="0"
                        Command="{x:Bind ApplySettingCommand}"
                        CornerRadius="18"
                        IsEnabled="{x:Bind IsApplyButtonEnable}"
                        Style="{ThemeResource AccentButtonStyle}">
                    <StackPanel Margin="12,0,12,0"
                                Orientation="Horizontal"
                                Spacing="8">
                        <FontIcon VerticalAlignment="Center"
                                  FontSize="16"
                                  Glyph="&#xE8FB;" />
                        <!--  应用  -->
                        <TextBlock VerticalAlignment="Center" Text="{x:Bind lang:Lang.Common_Apply}" />
                    </StackPanel>
                </Button>
                <TextBlock Margin="24,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="{x:Bind ErrorMessage}"
                           TextTrimming="WordEllipsis" />
            </StackPanel>
        </Grid>

    </Grid>
</sf:PageBase>
