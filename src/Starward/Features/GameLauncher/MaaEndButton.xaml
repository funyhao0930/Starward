<?xml version="1.0" encoding="utf-8" ?>
<UserControl x:Class="Starward.Features.GameLauncher.MaaEndButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:lang="using:Starward.Language"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             x:DefaultBindMode="OneWay"
             mc:Ignorable="d">

    <Button Padding="0"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            BorderThickness="0"
            CornerRadius="8"
            Style="{ThemeResource DateTimePickerFlyoutButtonStyle}"
            ToolTipService.ToolTip="MaaEnd">
        <Grid>
            <!--  还没选 MaaEnd.exe 或取不到图标时显示  -->
            <FontIcon FontSize="20"
                      Glyph="&#xE99A;"
                      Visibility="{x:Bind Icon, Converter={StaticResource ObjectToVisibilityReversedConverter}}" />
            <Image Width="26"
                   Height="26"
                   Source="{x:Bind Icon}"
                   Stretch="Uniform" />
        </Grid>

        <Button.Flyout>
            <Flyout x:Name="Flyout_MaaEnd" Placement="LeftEdgeAlignedTop">
                <Grid Margin="-12,-12,-8,-12" ColumnSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.RowSpan="2"
                          Width="100"
                          Height="100">
                        <FontIcon FontSize="48"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                  Glyph="&#xE99A;"
                                  Visibility="{x:Bind Icon, Converter={StaticResource ObjectToVisibilityReversedConverter}}" />
                        <Image Width="64"
                               Height="64"
                               Source="{x:Bind Icon}"
                               Stretch="Uniform" />
                    </Grid>

                    <TextBlock Grid.Column="1"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Bottom"
                               FontSize="16"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="MaaEnd" />

                    <!--  已选好 MaaEnd.exe：启动  -->
                    <Border Grid.Row="1"
                            Grid.Column="1"
                            Height="36"
                            MinWidth="120"
                            Margin="0,8,0,0"
                            VerticalAlignment="Top"
                            Background="{ThemeResource CustomOverlayAcrylicBrush}"
                            CornerRadius="18"
                            Visibility="{x:Bind ExePath, Converter={StaticResource ObjectToVisibilityConverter}}">
                        <Button HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                Command="{x:Bind LaunchCommand}"
                                Style="{ThemeResource DateTimePickerFlyoutButtonStyle}">
                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind lang:Lang.MaaEndButton_Start}" />
                        </Button>
                    </Border>

                    <!--  还没选：先选 MaaEnd.exe  -->
                    <Border Grid.Row="1"
                            Grid.Column="1"
                            Height="36"
                            MinWidth="120"
                            Margin="0,8,0,0"
                            VerticalAlignment="Top"
                            Background="{ThemeResource CustomOverlayAcrylicBrush}"
                            CornerRadius="18"
                            Visibility="{x:Bind ExePath, Converter={StaticResource ObjectToVisibilityReversedConverter}}">
                        <Button Padding="16,0"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                Command="{x:Bind ChoosePathCommand}"
                                Style="{ThemeResource DateTimePickerFlyoutButtonStyle}">
                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind lang:Lang.MaaEndButton_ChoosePath}" />
                        </Button>
                    </Border>

                    <!--  已选好时才有：换位置、打开文件夹  -->
                    <StackPanel Grid.Row="2"
                                Grid.ColumnSpan="2"
                                Margin="8,0,8,6"
                                HorizontalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="4"
                                Visibility="{x:Bind ExePath, Converter={StaticResource ObjectToVisibilityConverter}}">
                        <HyperlinkButton Padding="6,2"
                                         Command="{x:Bind ChoosePathCommand}"
                                         FontSize="12">
                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind lang:Lang.MaaEndButton_ChangePath}" />
                        </HyperlinkButton>
                        <HyperlinkButton Padding="6,2"
                                         Command="{x:Bind OpenFolderCommand}"
                                         FontSize="12">
                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind lang:Lang.MaaEndButton_OpenFolder}" />
                        </HyperlinkButton>
                    </StackPanel>

                </Grid>
            </Flyout>
        </Button.Flyout>
    </Button>

</UserControl>
