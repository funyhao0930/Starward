<?xml version="1.0" encoding="utf-8" ?>
<UserControl x:Class="Starward.Features.GameLauncher.GameRoleCardButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:lang="using:Starward.Language"
             xmlns:local="using:Starward.Features.GameLauncher"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             x:DefaultBindMode="OneWay"
             Visibility="Collapsed"
             mc:Ignorable="d">

    <!--  与实时便笺同一个样子：右边侧栏的一个图标，点开才显示角色卡片  -->
    <Button Padding="0"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            BorderThickness="0"
            CornerRadius="8"
            Style="{ThemeResource DateTimePickerFlyoutButtonStyle}">

        <Image Margin="4" Source="{x:Bind IconUri}" />

        <Button.Flyout>
            <Flyout Opening="Flyout_Card_Opening" Placement="LeftEdgeAlignedTop">

                <Grid Width="340" RowSpacing="8">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!--  角色名，切换与刷新  -->
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Name="Button_SwitchRole"
                                Width="28"
                                Height="28"
                                Padding="0"
                                IsEnabled="{x:Bind CanSwitchRole}"
                                Style="{ThemeResource DateTimePickerFlyoutButtonStyle}"
                                ToolTipService.ToolTip="{x:Bind lang:Lang.GameRoleCard_SwitchRole}">
                            <FontIcon FontSize="14"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                      Glyph="&#xE8AB;"
                                      IsTextScaleFactorEnabled="False" />
                            <Button.Flyout>
                                <Flyout Placement="TopEdgeAlignedLeft">
                                    <ListView MinWidth="240"
                                              MaxHeight="320"
                                              IsItemClickEnabled="True"
                                              ItemClick="ListView_Roles_ItemClick"
                                              ItemsSource="{x:Bind Roles}"
                                              SelectionMode="None">
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="local:GameRoleCardRole">
                                                <StackPanel Padding="0,6,0,6" Spacing="2">
                                                    <TextBlock>
                                                        <Run FontWeight="SemiBold" Text="{x:Bind RoleName}" />
                                                        <Run Text="  " />
                                                        <Run Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind RegionName}" />
                                                    </TextBlock>
                                                    <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}">
                                                        <Run Text="{x:Bind RoleId}" />
                                                        <Run Text="·" />
                                                        <Run Text="{x:Bind AccountName}" />
                                                    </TextBlock>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                        <TextBlock Grid.Column="1"
                                   VerticalAlignment="Center"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Text="{x:Bind RoleName}"
                                   TextTrimming="CharacterEllipsis" />
                        <Grid Grid.Column="2">
                            <Button Width="28"
                                    Height="28"
                                    Padding="0"
                                    Command="{x:Bind RefreshCommand}"
                                    Style="{ThemeResource DateTimePickerFlyoutButtonStyle}"
                                    ToolTipService.ToolTip="{x:Bind lang:Lang.Common_Refresh}"
                                    Visibility="{x:Bind IsLoading, Converter={StaticResource BoolToVisibilityReversedConverter}}">
                                <FontIcon FontSize="14"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                          Glyph="&#xE72C;"
                                          IsTextScaleFactorEnabled="False" />
                            </Button>
                            <ProgressRing Width="16"
                                          Height="16"
                                          IsActive="{x:Bind IsLoading}" />
                        </Grid>
                    </Grid>

                    <!--  等级与 UID  -->
                    <Grid Grid.Row="1"
                          ColumnSpacing="8"
                          Visibility="{x:Bind HasCard}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center"
                                   FontSize="13"
                                   Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}">
                            <Run Text="{x:Bind Card.LevelLabel}" />
                            <Run FontWeight="SemiBold" Text="{x:Bind Card.Level}" />
                        </TextBlock>
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="4">
                            <TextBlock VerticalAlignment="Center"
                                       FontSize="13"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                <Run Text="{x:Bind Card.UidLabel}" />
                                <Run Text="{x:Bind Card.Role.RoleId}" />
                            </TextBlock>
                            <Button Width="24"
                                    Height="24"
                                    Padding="0"
                                    Command="{x:Bind CopyUidCommand}"
                                    Style="{ThemeResource DateTimePickerFlyoutButtonStyle}"
                                    ToolTipService.ToolTip="{x:Bind lang:Lang.Common_Copy}">
                                <FontIcon FontSize="12"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                          Glyph="&#xE8C8;"
                                          IsTextScaleFactorEnabled="False" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!--  数值  -->
                    <Border Grid.Row="2"
                            Padding="12,10,12,10"
                            Background="{ThemeResource CustomOverlayAcrylicBrush}"
                            CornerRadius="6">
                        <Grid>
                            <ItemsRepeater ItemsSource="{x:Bind Stats}" Visibility="{x:Bind ErrorMessage, Converter={StaticResource ObjectToVisibilityReversedConverter}}">
                                <ItemsRepeater.Layout>
                                    <UniformGridLayout MaximumRowsOrColumns="2"
                                                       MinColumnSpacing="8"
                                                       MinItemWidth="140"
                                                       MinRowSpacing="10" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="local:GameRoleCardStatItem">
                                        <Grid ColumnSpacing="8" ToolTipService.ToolTip="{x:Bind Name}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition />
                                            </Grid.ColumnDefinitions>
                                            <Image Width="36"
                                                   Height="36"
                                                   VerticalAlignment="Center"
                                                   Source="{x:Bind IconUri}" />
                                            <StackPanel Grid.Column="1"
                                                        VerticalAlignment="Center"
                                                        Spacing="0">
                                                <TextBlock>
                                                    <Run FontSize="16"
                                                         FontWeight="SemiBold"
                                                         Text="{x:Bind CurrentText}" />
                                                    <Run FontSize="13"
                                                         Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                         Text="{x:Bind MaxText}" />
                                                </TextBlock>
                                                <StackPanel Orientation="Horizontal"
                                                            Spacing="4"
                                                            Visibility="{x:Bind DetailText, Converter={StaticResource ObjectToVisibilityConverter}}">
                                                    <FontIcon FontSize="11"
                                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                              Glyph="&#xE823;"
                                                              IsTextScaleFactorEnabled="False"
                                                              Visibility="{x:Bind IsCountdown}" />
                                                    <TextBlock FontSize="12"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                               Text="{x:Bind DetailText}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                            <TextBlock MinHeight="40"
                                       VerticalAlignment="Center"
                                       FontSize="13"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="{x:Bind ErrorMessage}"
                                       TextWrapping="Wrap"
                                       Visibility="{x:Bind ErrorMessage, Converter={StaticResource ObjectToVisibilityConverter}}" />
                        </Grid>
                    </Border>

                    <!--  说明  -->
                    <Grid Grid.Row="3"
                          ColumnSpacing="6"
                          Visibility="{x:Bind Card.Footnote, Converter={StaticResource ObjectToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <FontIcon Margin="0,2,0,0"
                                  VerticalAlignment="Top"
                                  FontSize="11"
                                  Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                  Glyph="&#xE946;"
                                  IsTextScaleFactorEnabled="False" />
                        <TextBlock Grid.Column="1"
                                   FontSize="11"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                   Text="{x:Bind Card.Footnote}"
                                   TextWrapping="Wrap" />
                    </Grid>

                </Grid>

            </Flyout>
        </Button.Flyout>
    </Button>

</UserControl>
