<?xml version="1.0" encoding="utf-8" ?>
<sf:WindowEx x:Class="Starward.Features.GameLauncher.VendorNoticeWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:lang="using:Starward.Language"
             xmlns:local="using:Starward.Features.GameLauncher"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:sf="using:Starward.Frameworks"
             mc:Ignorable="d">

    <!--  颜色、圆角都由 VendorNoticeTheme 按游戏给，这里只排版；浅色主题只影响载入圈与按钮  -->
    <Grid x:Name="RootGrid"
          Loaded="RootGrid_Loaded"
          RequestedTheme="Light"
          Tapped="RootGrid_Tapped">

        <Grid.Resources>
            <!--  去掉系统的选中与悬停底色，选中样子由数据模板自己画  -->
            <Style x:Key="BareListViewItemStyle" TargetType="ListViewItem">
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListViewItem">
                            <ContentPresenter HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Background="Transparent"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              ContentTransitions="{TemplateBinding ContentTransitions}" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Grid.Resources>

        <Grid x:Name="Grid_Board"
              MaxWidth="1100"
              MaxHeight="660"
              Margin="24"
              Tapped="Grid_Board_Tapped">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  分页与关闭  -->
            <Grid x:Name="Grid_Header"
                  MinHeight="60"
                  Padding="16,0,8,0">
                <ListView x:Name="ListView_Tabs"
                          Margin="0,0,56,0"
                          VerticalAlignment="Center"
                          ItemContainerStyle="{StaticResource BareListViewItemStyle}"
                          ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                          ScrollViewer.HorizontalScrollMode="Enabled"
                          ScrollViewer.VerticalScrollMode="Disabled"
                          SelectionChanged="ListView_Tabs_SelectionChanged"
                          SelectionMode="Single">
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsStackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:VendorNoticeTabItem">
                            <Grid Height="40"
                                  MinWidth="{x:Bind Theme.TabMinWidth}"
                                  Margin="{x:Bind Theme.TabMargin}"
                                  Padding="20,0,20,0"
                                  Background="{x:Bind Background, Mode=OneWay}"
                                  CornerRadius="{x:Bind Theme.TabCornerRadius}"
                                  PointerEntered="Tab_PointerEntered"
                                  PointerExited="Tab_PointerExited">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock HorizontalAlignment="Center"
                                               FontFamily="{x:Bind Theme.TabFontFamily}"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               Foreground="{x:Bind Foreground, Mode=OneWay}"
                                               Text="{x:Bind Title}" />
                                    <TextBlock Margin="0,-1,0,0"
                                               HorizontalAlignment="Center"
                                               CharacterSpacing="200"
                                               FontFamily="Bahnschrift"
                                               FontSize="9"
                                               Foreground="{x:Bind Foreground, Mode=OneWay}"
                                               Opacity="0.7"
                                               Text="{x:Bind Subtitle}"
                                               Visibility="{x:Bind Theme.ShowTabSubtitle}" />
                                </StackPanel>
                                <Rectangle Height="3"
                                           Margin="12,0,12,0"
                                           VerticalAlignment="Bottom"
                                           Fill="{x:Bind Indicator, Mode=OneWay}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <Button x:Name="Button_Close"
                        Width="44"
                        Height="44"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Click="Button_Close_Click"
                        Style="{ThemeResource DateTimePickerFlyoutButtonStyle}">
                    <FontIcon x:Name="FontIcon_Close"
                              FontSize="16"
                              Glyph="&#xE711;" />
                </Button>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!--  标题列表  -->
                <ListView x:Name="ListView_Notices"
                          Padding="0,8,0,8"
                          ItemContainerStyle="{StaticResource BareListViewItemStyle}"
                          SelectionChanged="ListView_Notices_SelectionChanged"
                          SelectionMode="Single">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:VendorNoticeListItem">
                            <Grid Margin="{x:Bind Theme.ListItemMargin}"
                                  Background="{x:Bind Background, Mode=OneWay}"
                                  CornerRadius="{x:Bind Theme.ListItemCornerRadius}"
                                  PointerEntered="NoticeItem_PointerEntered"
                                  PointerExited="NoticeItem_PointerExited">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Rectangle Fill="{x:Bind Marker, Mode=OneWay}" />
                                <StackPanel Grid.Column="1"
                                            Margin="12,11,8,11"
                                            Spacing="3">
                                    <TextBlock MaxLines="2"
                                               Foreground="{x:Bind Foreground, Mode=OneWay}"
                                               Text="{x:Bind Title}"
                                               TextTrimming="CharacterEllipsis"
                                               TextWrapping="Wrap" />
                                    <TextBlock FontSize="12"
                                               Foreground="{x:Bind SecondaryForeground, Mode=OneWay}"
                                               Text="{x:Bind Item.Date}" />
                                </StackPanel>
                                <Rectangle Grid.Column="2"
                                           Width="8"
                                           Height="8"
                                           Margin="0,15,14,0"
                                           VerticalAlignment="Top"
                                           Fill="{x:Bind DotBrush}"
                                           RadiusX="{x:Bind DotRadius}"
                                           RadiusY="{x:Bind DotRadius}"
                                           RenderTransformOrigin="0.5,0.5"
                                           Visibility="{x:Bind IsUnread, Mode=OneWay}">
                                    <Rectangle.RenderTransform>
                                        <RotateTransform Angle="{x:Bind DotAngle}" />
                                    </Rectangle.RenderTransform>
                                </Rectangle>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!--  正文  -->
                <Grid x:Name="Grid_Content" Grid.Column="1">
                    <WebView2 x:Name="WebView_Content"
                              DefaultBackgroundColor="Transparent"
                              Visibility="Collapsed" />
                    <ProgressRing x:Name="ProgressRing_Content"
                                  Width="40"
                                  Height="40"
                                  IsActive="False" />
                    <TextBlock x:Name="TextBlock_ContentError"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Text="{x:Bind lang:Lang.Common_NetworkError}"
                               Visibility="Collapsed" />
                </Grid>
            </Grid>

            <!--  整块公告板的载入与失败  -->
            <Grid x:Name="Grid_BoardState" Grid.Row="1">
                <ProgressRing x:Name="ProgressRing_Board"
                              Width="60"
                              Height="60"
                              IsActive="True" />
                <StackPanel x:Name="StackPanel_BoardError"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="12"
                            Visibility="Collapsed">
                    <TextBlock x:Name="TextBlock_BoardError" HorizontalAlignment="Center" />
                    <Button HorizontalAlignment="Center"
                            Click="Button_Retry_Click"
                            Content="{x:Bind lang:Lang.DownloadGamePage_Retry}" />
                </StackPanel>
            </Grid>
        </Grid>

    </Grid>
</sf:WindowEx>
