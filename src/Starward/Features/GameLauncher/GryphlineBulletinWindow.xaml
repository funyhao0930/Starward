<?xml version="1.0" encoding="utf-8" ?>
<sf:WindowEx x:Class="Starward.Features.GameLauncher.GryphlineBulletinWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="using:Starward.Features.GameLauncher"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:sf="using:Starward.Frameworks"
             mc:Ignorable="d">

    <!--  公告板由官方网页自己画，网页背景是透明的，这里只垫一层暗色  -->
    <Grid x:Name="RootGrid"
          Background="#66000000"
          Loaded="RootGrid_Loaded">
        <Border Padding="20"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="#60000000"
                CornerRadius="8">
            <ProgressRing Width="60"
                          Height="60"
                          Foreground="#FFFA00"
                          IsIndeterminate="True" />
        </Border>
        <WebView2 x:Name="WebView_Bulletin"
                  DefaultBackgroundColor="Transparent"
                  Visibility="Collapsed">
            <WebView2.Resources>
                <SolidColorBrush x:Key="BrushForThemeBackgroundColor" Color="Transparent" />
            </WebView2.Resources>
        </WebView2>
    </Grid>
</sf:WindowEx>
